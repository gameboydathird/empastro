---
import "../styles/global.css";

const { pageTitle = "Empire Gaming Organization" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Mono:wght@700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <nav class="topbar">
            <!-- Add /empastro/ to the home link -->
            <a href="/" class="brand">
                <!-- Add /empastro/ to the image path -->
                <img
                    src="/pics/EMPIRE.png"
                    alt="Empire Gaming"
                    class="brand-logo"
                />
                <span class="brand-name">Empire Gaming</span>
            </a>
            <div class="nav-links">
                <a href="/about" class="aboutbtn">About</a>
                <div class="dropdown">
                    <a href="/games" class="gamesbtn">Games</a>
                    <div class="dropdown-menu">
                        <!-- Add /empastro/ to the dropdown links -->
                        <a href="/cs2">CS2</a>
                        <a href="/valorant">Valorant</a>
                    </div>
                </div>
            </div>
        </nav>
        <slot />
    </body>
</html>
