---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout pageTitle="Empire Gaming Organization">
    <main class="main-content">
                <section class="about">
            <h2>About Us</h2>
            <p>Empire Gaming Organization is a premier esports organization dedicated to fostering talent and building a strong gaming community. We provide training, support, and opportunities for players to excel in competitive gaming.</p>
            <p>Our main games are CS2, Valorant, and Apex Legends, though our members play other games besides these three.</p>
            <p>As of right now we are looking for talented individuals to join and participate in online tournaments in the three aforementioned games.</p>
        </section>

    </main>
</BaseLayout>