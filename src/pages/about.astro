---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout pageTitle="Empire Gaming Organization">
    <main class="about-content">
        <section class="about">
            <h2>About Us</h2>
            <p>
                Empire Gaming Organization is a premier esports organization
                dedicated to fostering talent and building a strong gaming
                community. 
                <br>We provide training, support, and opportunities for
                players to excel in competitive gaming.
            </p>
            <p>
                Our main games are currently Counter-Strike 2 and Valorant, though we hope to expand into more areas and games as we grow.
            </p>
            <p>
                As of right now we are looking for talented individuals to join
                and participate in online tournaments in the three
                aforementioned games.
            </p>
        </section>
    </main>
</BaseLayout>
