---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout pageTitle="CS2 Team - Empire Gaming">
    <main class="cs2-content">
        <div class="cs2-header">
            <div class="cs2imgbox">
                <img src="/pics/cs2emp.jpg" />
            </div>
            <div class="cs2topofpage">
                <h1>CS2 Roster</h1>
                <p class="cs2slogan">Competing in Counter-Strike 2</p>
            </div>
        </div>
    </main>
    <div class="playerlist">
        <h2>Player List:</h2>
    </div>
</BaseLayout>
