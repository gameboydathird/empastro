---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout pageTitle="CS2 Team - Empire Gaming">
    <main class="cs2-content">
        <div class="cs2-header">
            <div class="cs2imgbox">
                <img src="/pics/cs2emp.jpg" />
            </div>
            <div class="cs2topofpage">
                <h1>CS2 Roster</h1>
                <p class="cs2slogan">Competing in Counter-Strike 2</p>
            </div>
        </div>
    </main>
    <div class="playerlist">
        <h2>Player List:</h2>
        <ul class="cs2players">
            <li>Player 1: <span class="cs2p1">[emp] omega2</span></li>
            <li>Player 2: [emp] wordidont</li>
            <li>Player 3: LF</li>
            <li>Player 4: LF</li>
            <li>Player 5: LF</li>
        </ul>
    </div>
</BaseLayout>
