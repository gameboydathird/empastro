---
import BaseLayout from "../layouts/baselayout.astro";
---

<BaseLayout pageTitle="Valorant Team - Empire Gaming">
    <main class="valorant-content">
        <div class="valorant-header">
            <div class="valorantimgbox">
                <img src="/pics/valemp.jpg" />
            </div>
            <div class="valoranttopofpage">
                <h1>valorant Roster</h1>
                <p class="valorantslogan">Competing in Counter-Strike 2</p>
            </div>
        </div>
    </main>
    <div class="playerlist">
        <h2>Player List:</h2>
        <ul class="valorantplayers">
            <li>Player 1: LF</li>
            <li>Player 2: LF</li>
            <li>Player 3: LF</li>
            <li>Player 4: LF</li>
            <li>Player 5: LF</li>
        </ul>
    </div>
</BaseLayout>